<mujoco model="Ctrl_circle_cloth">
    <include file="scene.xml"/>
    <option timestep="0.002" iterations="100" integrator="implicitfast"/>

    <asset>
        <material name="cloth_mat" rgba="1 0 0 0.3"/>
        <material name="table_mat" rgba="0.64 0.4 0.2 1"/>
    </asset>

    <asset>
        <mesh name="circle_mesh" file="rclipped_circle.obj"/>
    </asset>

    <worldbody>

        <body name="table" pos="0 0 0.05">
            <geom type="box" size="0.2 0.2 0.02" pos="0 0 0.02" material="table_mat"/>
        </body>

        <flexcomp type="mesh" file="clipped_circle.obj" pos="0 0 0.1" dim="2"
                    origin="0 0 0" radius="0.0014" rgba="0 0.7 0 0.3" mass="5" name="cut_circle">
            <!-- <contact condim="3" solref="0.01 1" solimp="0.95 0.99 0.0001"/> -->
            <!-- <edge equality="true" solref="0.01 1" solimp="0.99 0.999 0.0001 1 10" damping="0.0001"/> -->
            <!-- <edge equality="true" solref="0.001 1" solimp="0.99 0.99 0.001 0.5 10" damping="0.0001"/> -->
            <edge equality="true" solref="1e-5 1" solimp="1 1 0 0 1" damping="0.0"/>
            <!-- <elasticity poisson="0.4" thickness="0.002" young="1e8" damping="0.001" elastic2d="bend"/> -->
        </flexcomp>

        <body name="spoon_base" pos="0.0 0.0 0.108">
            <joint name="base_free" type="free"/>
            <geom name="spoon_handle" pos="0.045 0.0 0.0" type="cylinder"
                size="0.0035 0.05" mass="0.01"
                quat="0 0.707 0 0.707" rgba="0.4 0.4 0.4 1"/>

            <body name="handle0" pos="-0.005 0.0 0.0">
                <geom name="handle0" type="sphere" size="0.004" mass="0.001" rgba="1 0.8 0 1"/>
            </body>
            <body name="handle1" pos="0.005 0.0 0.0">
                <geom name="handle1" type="sphere" size="0.004" mass="0.001" rgba="1 0.8 0 1"/>
            </body>
            <body name="handle2" pos="0.015 0.0 0.0">
                <geom name="handle2" type="sphere" size="0.004" mass="0.001" rgba="1 0.8 0 1"/>
            </body>
            <body name="handle3" pos="0.025 0.0 0.0">
                <geom name="handle3" type="sphere" size="0.004" mass="0.001" rgba="1 0.8 0 1"/>
            </body>
            <body name="handle4" pos="0.035 0.0 0.0">
                <geom name="handle4" type="sphere" size="0.004" mass="0.001" rgba="1 0.8 0 1"/>
            </body>
            <body name="handle5" pos="0.045 0.0 0.0">
                <geom name="handle5" type="sphere" size="0.004" mass="0.001" rgba="1 0.8 0 1"/>
            </body>
        </body>


    </worldbody>


    <actuator>
        <general joint="base_free" gainprm="200 0 0" gear="1 0 0 0 0 0"/>  
        <general joint="base_free" gainprm="200 0 0" gear="0 1 0 0 0 0"/>  
        <general joint="base_free" gainprm="200 0 0" gear="0 0 1 0 0 0"/>  
        <general joint="base_free" gainprm="100 0 0" gear="0 0 0 1 0 0"/>  
        <general joint="base_free" gainprm="100 0 0" gear="0 0 0 0 1 0"/>  
        <general joint="base_free" gainprm="100 0 0" gear="0 0 0 0 0 1"/>  
    </actuator>



    <!-- <equality>
        <weld body1="marker0" body2="cut_circle_1"/>
    </equality> -->


    <equality>
        <weld body1="handle1" body2="cut_circle_0"/>
        <weld body1="handle1" body2="cut_circle_1"/>
        <weld body1="handle2" body2="cut_circle_2"/>
        <weld body1="handle3" body2="cut_circle_3"/>
        <weld body1="handle4" body2="cut_circle_4"/>
    </equality>

</mujoco>




