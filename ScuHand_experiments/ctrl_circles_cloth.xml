<mujoco model="Ctrl_circle_cloth">
    <include file="scene.xml"/>
    <option timestep="0.002" iterations="100" integrator="implicitfast"/>

    <asset>
        <material name="cloth_mat" rgba="1 0 0 0.3"/>
        <material name="table_mat" rgba="0.64 0.4 0.2 1"/>
    </asset>

    <asset>
        <mesh name="circle_mesh" file="rclipped_circle.obj"/>
    </asset>

    <worldbody>

        <body name="table" pos="0 0 0.05">
            <geom type="box" size="2 2 0.02" pos="0 0 0.02" material="table_mat"/>
        </body>

        <!-- <body name="center_ball" pos="0.00 -0.025 0.11">
            <joint type="free"/>
            <geom type="sphere" size="0.002" mass="10" rgba="0 1 0 1"/>
        </body> -->

        <flexcomp type="mesh" file="clipped_concentric_circle.obj" pos="0 0 0.1" dim="2"
                    origin="0 0 0" radius="0.0005" rgba="0 0.7 0 0.3" mass="1" name="c">
            <!-- <contact condim="3" solref="0.01 1" solimp="0.95 0.99 0.0001"/> -->
            <!-- <edge equality="true" solref="0.01 1" solimp="0.99 0.999 0.0001 1 10" damping="0.0001"/> -->
            <!-- <edge equality="true" solref="0.001 1" solimp="0.99 0.99 0.001 0.5 10" damping="0.0001"/> -->
            <edge equality="true" solref="1e-5 1" solimp="1 1 0 0 1" damping="0.0"/>
            <elasticity poisson="0.4" thickness="0.001" young="1e8" damping="0.001" elastic2d="bend"/>
        </flexcomp>

        <body name="left" pos="0.0 0.0 0.102">
            <joint name="left" type="free"/>
            <geom name="left" pos="0.0287 0.0051 0.001" type="cylinder"
                size="0.0001 0.022" mass="0.001"
                quat="0.7071 -0.1228 0.6964 0.0" rgba="0.4 0.4 0.4 1"/>

            <body name="left1" pos="0.00820673 0.00144707 0.0">
                <geom name="left1" type="sphere" size="0.0005" mass="0.0001" rgba="1 0.8 0 1"/>
            </body>
            <body name="left2" pos="0.01641346 0.00289414 00.0">
                <geom name="left2" type="sphere" size="0.0005" mass="0.0001" rgba="1 0.8 0 1"/>
            </body>
            <body name="left3" pos="0.02462019 0.0043412 0.0">
                <geom name="left3" type="sphere" size="0.0005" mass="0.0001" rgba="1 0.8 0 1"/>
            </body>
            <body name="left4" pos="0.03282693 0.00578827 0.0">
                <geom name="left4" type="sphere" size="0.0005" mass="0.0001" rgba="1 0.8 0 1"/>
            </body>
            <body name="left5" pos="0.04103366 0.00723534 0.0">
                <geom name="left5" type="sphere" size="0.0005" mass="0.0001" rgba="1 0.8 0 1"/>
            </body>
            <body name="left6" pos="0.04924039 0.00868241 0.0">
                <geom name="left6" type="sphere" size="0.0005" mass="0.0001" rgba="1 0.8 0 1"/>
            </body>
        </body>

        <body name="right" pos="0.0 0.0 0.102">
            <joint name="right" type="free"/>
            <geom name="right" pos="0.0287 0.0 0.001" type="cylinder"
                size="0.0001 0.022" mass="0.0001"
                quat="0 0.707 0 0.707" rgba="0.4 0.4 0.4 1"/>

            <body name="right1" pos="0.00833333 0.0 0.0">
                <geom name="right1" type="sphere" size="0.0005" mass="0.0001" rgba="0 1 1 1"/>
            </body>
            <body name="right2" pos="0.01666667 0.0 0.0">
                <geom name="right2" type="sphere" size="0.0005" mass="0.0001" rgba="0 1 1 1"/>
            </body>
            <body name="right3" pos="0.025 0.0 0.0">
                <geom name="right3" type="sphere" size="0.0005" mass="0.0001" rgba="0 1 1 1"/>
            </body>
            <body name="right4" pos="0.03333333 0.0 0.0">
                <geom name="right4" type="sphere" size="0.0005" mass="0.0001" rgba="0 1 1 1"/>
            </body>
            <body name="right5" pos="0.04166667 0.0 0.0">
                <geom name="right5" type="sphere" size="0.0005" mass="0.0001" rgba="0 1 1 1"/>
            </body>
            <body name="right6" pos="0.05 0.0 0.0">
                <geom name="right6" type="sphere" size="0.0005" mass="0.0001" rgba="0 1 1 1"/>
            </body>
        </body>




    </worldbody>


    <actuator>
        <general joint="left" gainprm="200 0 0" gear="1 0 0 0 0 0"/>  
        <general joint="left" gainprm="200 0 0" gear="0 1 0 0 0 0"/>  
        <general joint="left" gainprm="200 0 0" gear="0 0 1 0 0 0"/>  
        <general joint="left" gainprm="100 0 0" gear="0 0 0 1 0 0"/>  
        <general joint="left" gainprm="100 0 0" gear="0 0 0 0 1 0"/>  
        <general joint="left" gainprm="100 0 0" gear="0 0 0 0 0 1"/>  
    </actuator>

    <actuator>
        <general joint="right" gainprm="200 0 0" gear="1 0 0 0 0 0"/>  
        <general joint="right" gainprm="200 0 0" gear="0 1 0 0 0 0"/>  
        <general joint="right" gainprm="200 0 0" gear="0 0 1 0 0 0"/>  
        <general joint="right" gainprm="100 0 0" gear="0 0 0 1 0 0"/>  
        <general joint="right" gainprm="100 0 0" gear="0 0 0 0 1 0"/>  
        <general joint="right" gainprm="100 0 0" gear="0 0 0 0 0 1"/>  
    </actuator>

    <equality>
        <weld body1="left1" body2="c_1"/>
        <weld body1="left2" body2="c_17"/>
        <weld body1="left3" body2="c_33"/>
        <weld body1="left4" body2="c_49"/>
        <weld body1="left5" body2="c_65"/>
        <weld body1="left6" body2="c_81"/>
    </equality>

    <equality>
        <weld body1="right1" body2="c_16"/>
        <weld body1="right2" body2="c_32"/>
        <weld body1="right3" body2="c_48"/>
        <weld body1="right4" body2="c_64"/>
        <weld body1="right5" body2="c_80"/>
        <weld body1="right6" body2="c_96"/>
    </equality>



</mujoco>




