<mujoco model="robotiq_hande">
  <!-- hand-e URDF from https://github.com/cambel/robotiq -->
  <!-- then yuni loaded it in mujoco to convert to xml and used online tools to convert dae to stl -->
  <!-- then a bunch of manual copy and pasting from other gripper examples -->
  <default>
    <default class="peg_visual">
      <geom group="1" contype="0" conaffinity="0" rgba="0 0.7 0.7 1" />
    </default>
    <default class="peg_collision">
      <geom group="0" contype="0" conaffinity="1" solref="0.02 1" friction="1 0.005 0.0001" condim="4" />
    </default>
  </default>

  <asset>
    <mesh name="hand-e" file="meshes/robotiq_hand_e_gripper/hand-e.stl" />
    <mesh name="finger_1" file="meshes/robotiq_hand_e_gripper/finger_1.stl" />
    <mesh name="finger_2" file="meshes/robotiq_hand_e_gripper/finger_2.stl" />

    <!-- All peg meshes will be added dynamically -->

  </asset>

  <worldbody>
    <body name="gripper_base" pos="0 0 0">
      <geom type="cylinder" pos="0 0 0.0175" size="0.0315 0.0175" group="1" name="gripper_base_visual" rgba="1 1 1 1" />
      <geom type="cylinder" pos="0 0 0.045" size="0.0375 0.01" group="1" rgba="1 1 1 1" />
      <geom type="cylinder" pos="0 0 0.0175" size="0.0315 0.0175" group="0" name="gripper_base_collision"/>
      <geom type="cylinder" pos="0 0 0.045" size="0.0375 0.01" group="0" rgba="1 1 1 1" />
      <site name="ft_frame" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 1" type="sphere" group="1" />
      <!-- This site was added for visualization. -->
      <body name="eef" pos="0 0 0">
        <site name="grip_site" pos="0 0 0" size="0.01 0.01 0.01" rgba="1 0 0 0.5" type="sphere" group="1" />
        <site name="ee_x" pos="0.1 0 0" size="0.005 .1" quat="0.707105  0 0.707108 0 " rgba="1 0 0 0" type="cylinder" group="1" />
        <site name="ee_y" pos="0 0.1 0" size="0.005 .1" quat="0.707105 0.707108 0 0" rgba="0 1 0 0" type="cylinder" group="1" />
        <site name="ee_z" pos="0 0 0.1" size="0.005 .1" quat="1 0 0 0" rgba="0 0 1 0" type="cylinder" group="1" />
        <!-- This site was added for visualization. -->
        <site name="grip_site_cylinder" pos="0 0 0" size="0.005 10" rgba="0 1 0 0.3" type="cylinder" group="1" />
      </body>
      <body name="right_gripper" pos="0 0 0.055">
        <!-- Note: x and y translation observed to be negligible due to moment arm induced by gripper length causing mostly rotation -->
          <joint name="flex_wrist_z" axis="0 0 1" type="slide" stiffness="1000" damping="1.0" range="0 0.01" />
        <joint name="flex_wrist_rx" axis="1 0 0" type="hinge" stiffness="0.5" damping="0.005" />
        <joint name="flex_wrist_ry" axis="0 1 0" type="hinge" stiffness="0.5" damping="0.005" />
        <joint name="flex_wrist_rz" axis="0 0 1" type="hinge" stiffness="5" damping="1.0" />
        <!-- inertia manually copied over from URDF, not autogenerated via mujoco -->
        <inertial pos="0 0 0.04607" mass="0.86387" diaginertia="1017560E-9 1028041E-9 489810E-9" />
        <geom type="mesh" quat="0.7071 0 0 0.7071" contype="0" conaffinity="0" group="1" mesh="hand-e" name="hand_visual" rgba="0.1 0.1 0.1 1" />
        <!-- <geom type="mesh" mesh="hand-e-collision"  group="0" name="hand_collision"/> -->
        <geom type="cylinder" quat="0.7071 0 0 0.7071" pos="0 0 0.049" size="0.0375 0.049" group="0" name="hand_collision" />

        <!-- the soft part rotates the gripper by 90deg -->
        <body name="finger_and_peg" quat="0.7071 0 0 0.7071">
          <!-- TODO: it seems that the inertial data of the fingers are missing? -->
          <geom type="mesh" name="finger1_visual" pos="-0.0125 0 0.099" contype="0" conaffinity="0" group="1" mesh="finger_1" rgba="1 1 1 1" />
          <geom type="mesh" name="finger2_visual" pos="0.0125 0 0.099" contype="0" conaffinity="0" group="1" mesh="finger_2" rgba="1 1 1 1" />

          <body name="gripper_eef" pos="0 0 0.13">
            <site name="gripper_eef_site" pos="0 0 0" quat="0.7071 0 0 -0.7071"/>
            <body name="peg_wrapper">
              <site name="peg_ft_frame" pos="0.0 0.0 0.075" />
              <inertial pos="0.0 0.0 0.0375" mass="0.03" diaginertia="1e-5 1e-5 1e-5" />
              <!-- Peg bodies will be added dynamically -->
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <force name="force_ee" site="ft_frame" />
    <torque name="torque_ee" site="ft_frame" />
    <force name="force_peg" site="peg_ft_frame" />
    <torque name="torque_peg" site="peg_ft_frame" />
  </sensor>

</mujoco>
