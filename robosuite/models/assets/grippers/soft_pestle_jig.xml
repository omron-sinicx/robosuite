<mujoco model="soft_pestle_jig">
	<asset>
		<mesh name="pestle" file="meshes/soft_pestle_jig/inner.stl" scale="1 1 1" />
		<mesh name="pestle_cage" file="meshes/soft_pestle_jig/outer.stl" scale="0.001 0.001 0.001" />
		<texture builtin="gradient" height="256" rgb1=".9 .9 1." rgb2=".2 .3 .4" type="skybox" width="256" />
		<texture file="../textures/light-gray-floor-tile.png" type="2d" name="texplane" />
		<material name="floorplane" reflectance="0.01" shininess="0.0" specular="0.0" texrepeat="2 2" texture="texplane" texuniform="true" />
	</asset>
	<default>
		<default class="pestle_visual">
			<geom group="1" rgba="0.1 0.1 0.1 1" />
		</default>
		<default class="pestle_collision">
			<geom group="0" solimp="0.998 0.998 0.001" solref="0.02 1" density="50" friction="0.95 0.3 0.1" condim="4" rgba="0.1 0.1 0.1 0.1" priority="100"/>
		</default>
	</default>
	<worldbody>
		<body name="pestle_body" pos="0 0 0" quat="1 0 0 0">
			<site name="ft_frame" pos="0 0 0" quat="0 0 1 0" size="0.01 0.01 0.01" rgba="1 0 0 1" type="sphere" group="1" />
			<!-- This site was added for visualization. -->
			<body name="eef2" pos="0 0 0.136" quat="0 0 1 0"/>
			<body name="eef" pos="0 0 0.136" quat="1 0 0 0">
				<site name="grip_site" pos="0 0 0.0" size="0.01 0.01 0.01" rgba="1 0 0 0.5" type="sphere" group="1" />
				<site name="ee_x" pos="0.01 0 0" size="0.0025 .01" quat="0.707105  0 0.707108 0 " rgba="1 0 0 1" type="cylinder" group="1" />
				<site name="ee_y" pos="0 0.01 0" size="0.0025 .01" quat="0.707105 0.707108 0 0" rgba="0 1 0 1" type="cylinder" group="1" />
				<site name="ee_z" pos="0 0 0.01" size="0.0025 .01" quat="1 0 0 0" rgba="0 0 1 1" type="cylinder" group="1" />
				<!-- This site was added for visualization. -->
				<site name="grip_site_cylinder" pos="0 0 0" size="0.005 1" rgba="0 1 0 0" type="cylinder" group="1" />
			</body>
			<body name="pestle_jig">
				<geom pos="0 0 0" quat="0.707107 0 0 0.707107" type="mesh" mesh="pestle_cage" name="pestle_cage_visualization" class="pestle_visual" />
				<geom pos="0 0 0" quat="0.707107 0 0 0.707107" type="mesh" mesh="pestle_cage" name="pestle_cage_collision" class="pestle_collision"/>

				<body name="pestle_jig_body" pos="0 0 0.02" quat="0.707107 0 0 0.707107">
					<inertial pos="0 0 0.08" mass="3e-2" diaginertia="1e-2 1e-2 1e-2" />

					<!-- <joint name="spring_x" axis="1 0 0" type="slide" stiffness="15000" damping="10.0" range="-0.002 0.0" frictionloss="1.0" />
					<joint name="spring_y" axis="0 1 0" type="slide" stiffness="15000" damping="10.0" range="-0.002 0.0" frictionloss="1.0" /> -->
					<joint name="spring_z" axis="0 0 1" type="slide" stiffness="5000" damping="10.0" range="-0.005 0.0" frictionloss="1.0" />

					<geom pos="0 0 0" type="mesh" mesh="pestle" name="pestle_inner_visualization" class="pestle_visual" />
					<geom pos="0 0 0" type="mesh" mesh="pestle" name="pestle_inner_collision" class="pestle_collision"/>
					<geom type="capsule" size="0.0135" fromto="0 0 0.02 0 0 0.102" name="pestle_visualization" group="1" rgba=".2 .8 .8 1" />
					<geom type="capsule" size="0.0135" fromto="0 0 0.02 0 0 0.102" name="pestle_collision" class="pestle_collision"/>
					<!-- <geom type="cylinder" size="0.0135 0.055" pos="0 0 0.0605" name="pestle_collision" class="pestle_collision" /> -->
				</body>
			</body>
		</body>
	</worldbody>
	<sensor>
		<force name="force_ee" site="ft_frame" />
		<torque name="torque_ee" site="ft_frame" />
	</sensor>
</mujoco>
