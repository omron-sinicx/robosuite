<mujoco model="hole">
  <default>
    <default class="collision">
      <geom group="0" type="mesh" solimp="0.9 0.95 0.001 0.5 2" density="100000" solref=".004 1" condim="6"/>
    </default>
  </default>
  <asset>
    <texture file="../textures/red-wood.png" type="cube" name="red-wood" />
    <material name="plate_mat" texture="red-wood" texrepeat="3 3" specular="0.4" shininess="0.1" />
    <mesh refquat="1 0 0 0" file="meshes/guriguri-large-rectangle-hole/Body6.stl" name="hole_collision_top"/>
    <mesh refquat="1 0 0 0" file="meshes/guriguri-large-rectangle-hole/Body7.stl" name="hole_collision_left"/>
    <mesh refquat="1 0 0 0" file="meshes/guriguri-large-rectangle-hole/Body8.stl" name="hole_collision_bottom"/>
    <mesh refquat="1 0 0 0" file="meshes/guriguri-large-rectangle-hole/Body9.stl" name="hole_collision_right"/>
  </asset>
  <worldbody>
    <body>
      <body name="object" pos="0 0 0">
        <geom mesh="hole_collision_top" class="collision" />
        <geom mesh="hole_collision_left" class="collision" />
        <geom mesh="hole_collision_bottom" class="collision" />
        <geom mesh="hole_collision_right" class="collision" />
      </body>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 -0.14" name="bottom_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 0.00" name="top_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0.06 0.06 0" name="horizontal_radius_site"/>

      <!-- <site rgba="0 0 0 0" size="0.005" pos="0 0 -0.14" name="bottom_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0 0 0.03" name="top_site"/>
      <site rgba="0 0 0 0" size="0.005" pos="0.03 0.03 0" name="horizontal_radius_site"/> -->
    </body>
  </worldbody>
</mujoco>
